{
  "name": "openread",
  "version": "0.4.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmednajaf/openread.git"
  },
  "description": "A free, local-first Safari and Chrome reading companion.",
  "scripts": {
    "build": "node dev/scripts/build-ui.cjs",
    "prepreview": "npm run build",
    "presafari": "npm run build",
    "test": "node --test dev/tests/*.test.cjs && python3 -m unittest discover -s dev/tests -p '*_test.py'",
    "preview": "node dev/scripts/preview.cjs",
    "safari": "node dev/scripts/safari.cjs",
    "chrome": "npm run build && node dev/scripts/chrome.cjs",
    "design:build": "node dev/scripts/build-design.cjs",
    "design": "node dev/scripts/design-preview.cjs",
    "typecheck": "tsc --project dev/config/tsconfig.json --noEmit",
    "site:build": "node dev/scripts/build-website.cjs",
    "site:dev": "npm run site:build && node dev/scripts/website-preview.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
